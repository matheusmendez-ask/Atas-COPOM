# Copie para .env e ajuste. O .env real é gitignored — nunca versione segredos.
# Todos os campos são opcionais: os defaults de src/config.py servem para rodar local.

# ── Geração de respostas (comando `ask`) ──────────────────────────────────────
# Único valor realmente obrigatório para o `ask`. Sem ele o comando falha com
# mensagem explicando o que setar — de propósito, para não responder sem fonte.
# Requer o extra opcional:  pip install -e ".[openai]"
LLM_API_KEY=nvapi-cole-sua-chave-aqui

# Endpoint compatível com a API da OpenAI. Trocar de provedor é só mudar estas
# duas linhas — não há código específico de fornecedor.
#   NVIDIA NIM  https://integrate.api.nvidia.com/v1   moonshotai/kimi-k3
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/  gemini-3.7-flash
#   OpenAI      https://api.openai.com/v1             gpt-4o-mini
#   OpenRouter  https://openrouter.ai/api/v1          <publisher>/<model>
#   Ollama      http://localhost:11434/v1             llama3.1   (LLM_API_KEY=ollama)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=moonshotai/kimi-k3
LLM_TEMPERATURE=0.2

# ── Vector store ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=copom_minutes
# QDRANT_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────────────
# Trocar de modelo com largura diferente exige recriar a coleção do Qdrant.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
# Só com EMBEDDING_PROVIDER=openai:
# OPENAI_API_KEY=

# ── Ingestão e chunking ──────────────────────────────────────────────────────
DEFAULT_INGEST_LIMIT=15
# Escolhido por medicao: 800 -> 150 levou hit@1 de 36% para 73% no golden set.
# Mudar exige reindexar (transform + index) e rodar `evaluate` de novo.
CHUNK_SIZE=150
CHUNK_OVERLAP=25

# ── Observabilidade ──────────────────────────────────────────────────────────
# Sem o Phoenix no ar (docker compose up -d), deixe false para evitar
# erros de conexão do exportador OTLP durante a execução.
ENABLE_PHOENIX=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=copom-rag-lakehouse
